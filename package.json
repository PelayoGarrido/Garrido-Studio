{
  "name": "garrido-studio-workspace",
  "private": true,
  "version": "1.1.0",
  "description": "Development commands only. The application is written in Rust.",
  "scripts": {
    "source:archive": "python3 tools/source_archive.py",
    "preview:archive": "python3 tools/archive_preview.py",
    "format": "python3 tools/dev.py format",
    "check": "python3 tools/dev.py check",
    "test": "python3 tools/dev.py test",
    "build": "python3 tools/dev.py build",
    "start": "python3 tools/dev.py start",
    "bundle": "python3 tools/dev.py bundle",
    "bench": "python3 tools/dev.py bench",
    "audit": "python3 tools/dev.py audit",
    "check:plugins": "python3 tools/plugin_smoke.py",
    "check:audio": "python3 tools/audio_smoke.py",
    "desktop:fetch": "python3 tools/desktop.py fetch",
    "desktop:format": "python3 tools/desktop.py format",
    "desktop:check": "python3 tools/desktop.py check",
    "qa:build:windows": "python3 tools/cross_tests.py windows",
    "qa:build:linux": "python3 tools/cross_tests.py linux",
    "qa:lint:windows": "python3 tools/cross_tests.py windows --check-only",
    "qa:lint:linux": "python3 tools/cross_tests.py linux --check-only",
    "desktop:build:linux": "python3 tools/cross_build_linux.py",
    "desktop:build:windows": "python3 tools/cross_build_windows.py",
    "desktop:check:windows": "python3 tools/cross_windows.py",
    "core:check:linux": "python3 tools/cross_core_linux.py",
    "desktop:build": "python3 tools/desktop.py build",
    "desktop:start": "python3 tools/desktop.py start",
    "desktop:audit": "python3 tools/dependency_audit.py",
    "desktop:preview": "python3 tools/desktop.py preview",
    "desktop:probe:stream": "python3 tools/desktop.py probe-stream",
    "desktop:probe": "python3 tools/desktop.py probe",
    "desktop:bundle": "python3 tools/package_desktop.py",
    "desktop:licenses": "python3 tools/licenses.py",
    "desktop:licenses:fetch": "python3 tools/licenses.py --fetch",
    "desktop:check:plugins": "python3 tools/desktop_plugins.py",
    "audit:ci": "python3 tools/security_ci.py",
    "audit:policy:test": "python3 -m unittest discover -s tools/tests",
    "release:bundle": "python3 tools/release_bundle.py",
    "release:publish": "python3 tools/publish_release.py",
    "web:check": "python3 tools/web_check.py",
    "web:dev": "pnpm --dir web dev"
  },
  "packageManager": "pnpm@10.14.0"
}
